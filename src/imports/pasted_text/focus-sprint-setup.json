      "tap": "keyboard opens",
      "placeholder": "e.g., Study Math Chapter 3",
      "filled_example": "Math Assignment – Chapter 3"
    },
    "duration_selector": {
      "default": "15 min",
      "behavior": "single-select segmented cards",
      "tap_25": "25 min becomes selected; 15 min becomes inactive",
      "tap_45": "45 min becomes selected",
      "tap_60": "60 min becomes selected",
      "tap_custom": "open custom duration picker/modal"
    },
    "start_button": {
      "tap": "advance to next screen: choose how to start"
    },
    "back_button": {
      "tap": "return to previous screen"
    },
    "analytics_button": {
      "tap": "open focus stats"
    },
