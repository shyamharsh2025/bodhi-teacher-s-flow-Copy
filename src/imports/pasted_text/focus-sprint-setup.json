      "today": "active",
      "explore": "navigate to Explore",
      "chat_center": "open assistant/chat",
      "sessions": "navigate to Sessions",
      "journey": "navigate to Journey"
    }
  },
  "quality_instructions_for_figma_make": [
    "Create all UI as editable Figma layers, not as one flat image.",
    "Use clean auto-layout where appropriate for cards, duration options, and bottom nav.",
    "Respect the 390x844 mobile frame.",
    "Keep exact visual hierarchy: hero at top, task card, duration card, CTA, floating bottom nav.",
    "The decorative wave should be subtle and should not overpower the title.",
    "Keep cards large, rounded, and airy.",
    "Keep the primary CTA above the bottom navigation with enough spacing.",
    "The bottom nav should match the Bodhi home screen style: white floating pill, Today active, center chat button raised.",
    "Do not add any elements not listed in this JSON."
  ]
