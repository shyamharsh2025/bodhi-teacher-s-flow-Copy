{
  "meta": {
    "name": "Bodhi - Focus Sprint Setup Screen",
    "purpose": "Prompt/spec for Figma Make to recreate an accurate, editable, interactive mobile screen.",
    "version": "1.0"
  },
  "screen": {
    "name": "Focus Sprint - What are you working on?",
    "device": "iPhone portrait",
    "frame": {
      "width": 390,
      "height": 844,
      "safe_area": true
    },
    "intent": "This is the first setup screen of Focus Sprint. The user enters the task they want to focus on, chooses the session length, and starts the focus sprint.",
    "must_match_reference": true
  },
  "design_language": {
    "app": "Bodhi",
    "style": "premium wellness + productivity app",
    "theme": "light mode",
    "mood": "calm, focused, clean, polished, soft, slightly futuristic",
    "visual_quality": "high fidelity, app-store-ready, not wireframe",
    "key_characteristics": [
      "soft lavender-white background",
      "large rounded white cards",
      "subtle purple glow shadows",
      "clean bold typography",
      "spacious layout",
      "purple primary actions",
      "floating bottom navigation",
      "gentle decorative abstract wave in header area"
    ],
    "do_not_include": [
      "no orb",
      "no step indicator numbers",
      "no focus boost toggle",
      "no extra recommendation copy",
      "no meditation or breathing content",
      "no dark mode",
      "no extra cards",
      "no gamified badges"
    ]
  },
  "tokens": {
    "colors": {
      "background_top": "#FAFBFF",
      "background_mid": "#F3F1FF",
      "background_bottom": "#F8F7FF",
