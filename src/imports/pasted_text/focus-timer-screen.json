  "design_goal": "Create a premium dark-mode Focus Sprint timer screen for the Bodhi app. This screen comes after the pre-focus breathwork screen and represents the active deep work session. It should feel calm, immersive, premium, focused, and visually consistent with the previous dark Focus Sprint screens. The width and proportions should match the provided reference closely. Height spacing should be slightly more breathable so the layout does not feel cramped vertically.",
  "visual_style": {
    "theme": "dark premium wellness productivity",
    "mood": "focused, calm, premium, immersive, minimal, futuristic but not flashy",
    "background": {
      "base_color": "#020713",
      "gradient": "very dark navy-black background with subtle indigo-violet undertones",
      "details": [
        "Use a darker background than the earlier timer version",
        "Add subtle vertical light streaks in deep blue and violet to match the other Focus Sprint dark screens",
        "Keep the background premium and atmospheric, not noisy",
        "Maintain strong contrast for text readability",
        "Add subtle glow behind the timer ring but do not over-brighten the background"
      ]
    },
    "accent_colors": {
      "primary_purple": "#6D5BFF",
      "electric_violet": "#8A76FF",
      "soft_lavender": "#B7AEFF",
      "glow_purple": "#7C5CFF",
      "white": "#FFFFFF",
      "muted_text": "#B7B4D8",
      "secondary_text": "#8F8AAE",
      "card_fill": "rgba(10, 16, 35, 0.76)",
      "card_border": "rgba(139, 124, 255, 0.22)"
